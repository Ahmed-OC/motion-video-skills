{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Motion Video Timeline v3.0 — Universal Creative Studio",
  "description": "Single source of truth for creative direction, emotional color script, optics, visuals, audio, transitions, and smart captions.",
  "type": "object",
  "required": ["fps", "duration", "width", "height", "scenes"],
  "properties": {
    "creativeDirection": {
      "type": "object",
      "description": "Mandatory Phase-0 Creative Director brief (either answered with the user via clarify or self-authored autonomously before coding).",
      "required": ["universe", "emotionalArc", "visualMetaphor", "signatureMoment", "forbiddenCliches"],
      "properties": {
        "universe": {
          "type": "string",
          "enum": [
            "cinematic-film",
            "documentary-archive",
            "3d-photoreal",
            "hybrid-cinema",
            "luxury-editorial",
            "storytelling-illustrated",
            "kinetic-manifesto",
            "saas-product",
            "tech-architecture",
            "data-journalism",
            "stem-explainer",
            "social-short",
            "fine-art"
          ]
        },
        "emotionalArc": { "type": "string", "description": "Scene-by-scene emotional & tonal progression." },
        "visualMetaphor": { "type": "string", "description": "Central visual idea carrying the film." },
        "typographyPairing": { "type": "string", "description": "Chosen Google Fonts pairing key or custom editorial duo." },
        "signatureMoment": { "type": "string", "description": "The ONE bold, memorable directorial gesture (85% restraint / 15% audacity)." },
        "soundPlan": { "type": "string", "description": "Score mood, VO tone, J-cut/L-cut swells, and dramatic silences." },
        "forbiddenCliches": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Explicit anti-AI-slop rules for this film (e.g. 'NO UI cards', 'NO HUD brackets', 'NO Inter font')."
        }
      }
    },
    "optics": {
      "type": "object",
      "description": "Analog & cinema optical post-processing applied across the film.",
      "properties": {
        "letterbox": { "type": "string", "enum": ["none", "1.85:1", "2.00:1", "2.39:1"] },
        "grain": { "type": "number", "minimum": 0, "maximum": 0.16 },
        "vignette": { "type": "number", "minimum": 0, "maximum": 0.85 },
        "halation": { "type": "number", "minimum": 0, "maximum": 0.25 },
        "paperTexture": { "type": "boolean" }
      }
    },
    "fps": { "type": "number", "minimum": 1, "maximum": 120, "description": "Frames per second. Quantize scene durations to integer frames / fps." },
    "duration": { "type": "number", "exclusiveMinimum": 0, "description": "Total duration in seconds (durationInFrames = round(duration * fps))." },
    "width": { "type": "integer", "minimum": 16 },
    "height": { "type": "integer", "minimum": 16 },
    "bpm": { "type": "number", "minimum": 40, "maximum": 240, "description": "Declared tempo grid (beat = 60/bpm seconds)." },
    "palette": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
      "description": "Master hex palette (prefer OKLCH-derived hues)."
    },
    "fonts": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Role -> typeface map, e.g. { display: 'Inter', body: 'Inter', mono: 'JetBrains Mono' }."
    },
    "audio": {
      "type": "object",
      "properties": {
        "music": { "type": ["string", "null"], "description": "'synth' (MVS.synthStudioAudio) | path to audio track | null" },
        "vo": { "type": ["string", "null"], "description": "Path to voiceover MP3/WAV generated BEFORE animating." },
        "sfx": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+@[0-9]+\\.?[0-9]*$", "description": "name@time cue, e.g. whoosh@4.0" }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "duration"],
        "properties": {
          "id": { "type": "string", "description": "Matches SCENES[id] function key in index.html." },
          "start": { "type": "number", "minimum": 0 },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "text": { "type": "string", "description": "Primary on-screen headline (hold >= 0.3s/word + 0.5s, min 1.4s)." },
          "narration": { "type": "string", "description": "Spoken voiceover line for this scene." },
          "device": { "type": "string", "description": "Primary visual anchor / MVS blueprint executed in this scene." },
          "shot": {
            "type": "string",
            "enum": ["establishing-wide", "split-lr", "split-rl", "macro-focus", "bento-command", "monumental-payoff"],
            "description": "Cinematographic shot topology & polarity (alternate across scenes to guide viewer Eye-Trace)."
          },
          "transition": {
            "type": "string",
            "enum": ["cut", "whip", "whip-right", "push-up", "portal", "zoom-out", "iris", "dissolve"],
            "description": "Motivated montage transition into this scene."
          },
          "suppressCaptions": { "type": "boolean", "description": "Suppress bottom captions when scene displays full-screen kinetic text." },
          "palette": {
            "type": ["array", "object"],
            "description": "Per-scene Emotional Color Script override (e.g. { bg, fg, accent, muted }) or hex array."
          },
          "cueTimes": { "type": "array", "items": { "type": "number" } }
        }
      }
    },
    "captions": {
      "type": "array",
      "description": "Smart multilingual word-level caption pages (from vo_gen.py v2.0).",
      "items": {
        "type": "object",
        "required": ["startMs", "durationMs", "text"],
        "properties": {
          "startMs": { "type": "integer", "minimum": 0 },
          "durationMs": { "type": "integer", "minimum": 200 },
          "text": { "type": "string", "maxLength": 80 },
          "tokens": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "fromMs", "toMs"],
              "properties": {
                "text": { "type": "string" },
                "fromMs": { "type": "integer", "minimum": 0 },
                "toMs": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "envelope": {
      "type": ["object", "null"],
      "description": "Optional per-frame normalized audio energy arrays from vo_gen.py for audio-reactive motion.",
      "properties": {
        "fps": { "type": "number" },
        "rms": { "type": "array", "items": { "type": "number" } },
        "bass": { "type": "array", "items": { "type": "number" } },
        "high": { "type": "array", "items": { "type": "number" } }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "aspect": { "type": "string", "enum": ["16:9", "9:16", "1:1", "21:9", "4:5"] },
        "style": { "type": "string", "description": "MVS theme name (e.g. 'linear-dark', 'swiss-brutalist', 'paperclip-cn', 'cyber-fui-jp', 'deep-ocean-atlas')." },
        "language": { "type": "string" }
      }
    }
  }
}
